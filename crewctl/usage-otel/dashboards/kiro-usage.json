{
  "uid": "kiro-crew-usage",
  "title": "Kiro Crew usage",
  "tags": [
    "kiro",
    "crewctl",
    "usage"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "graphTooltip": 1,
  "description": "Kiro Crew credit usage sent by `crewctl usage push` (kiro-kit). Metrics: kiro_credits_total and friends. Logs: one record per billed turn and per subagent run.",
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(kiro_credits_total, service.name)",
          "refId": "service"
        },
        "definition": "label_values(kiro_credits_total, service.name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(kiro_credits_total, agent)",
          "refId": "agent"
        },
        "definition": "label_values(kiro_credits_total, agent)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(kiro_credits_total, model)",
          "refId": "model"
        },
        "definition": "label_values(kiro_credits_total, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(kiro_credits_total, workspace)",
          "refId": "workspace"
        },
        "definition": "label_values(kiro_credits_total, workspace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Credits (from the kiro_*_total counters)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Credits in range",
      "description": "Every billed turn: chat, subagents, background and automation.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Billed turns",
      "description": "",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum (max_over_time(kiro_turns_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_turns_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Subagent share",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "(sum (max_over_time(kiro_credits_total{kind=\"subagent\", service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{kind=\"subagent\", service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])) or vector(0)) / sum (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Background share",
      "description": "Crew's own background jobs (tips, suggestions, titles, memory). Not caused by a chat.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "(sum (max_over_time(kiro_credits_total{kind=\"background\", service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{kind=\"background\", service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])) or vector(0)) / sum (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Burn rate (credits in the last hour)",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sum (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[1h]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[1h]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Last push",
      "description": "Seconds since `crewctl usage push` last ran. Red: the scheduler stopped or cannot reach this backend.",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "time() - max(max_over_time(kiro_usage_last_push_timestamp_seconds{service.name=~\"$service\"}[1d]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Credits over time, by kind",
      "description": "From the log records: each turn at the time it finished. chat = you and messaging channels; subagent; background; automation = cron, heartbeat, workflow.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${logs}"
          },
          "queryType": "statsRange",
          "legendFormat": "{{kind}}",
          "expr": "{service.name=~\"$service\"} event:=turn agent:~\"$agent\" workspace:~\"$workspace\" model:~\"$model\" | format if (kind:\"\") \"(none)\" as kind | stats by (kind) sum(credits) as credits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Credits over time, by agent",
      "description": "From the log records: each turn at the time it finished. ",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${logs}"
          },
          "queryType": "statsRange",
          "legendFormat": "{{agent}}",
          "expr": "{service.name=~\"$service\"} event:=turn agent:~\"$agent\" workspace:~\"$workspace\" model:~\"$model\" | format if (agent:\"\") \"(none)\" as agent | stats by (agent) sum(credits) as credits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Credits by agent",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sort_desc(label_replace(sum by (agent) (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])), \"agent\", \"(none)\", \"agent\", \"\"))",
          "legendFormat": "{{agent}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 10
    },
    {
      "type": "bargauge",
      "title": "Credits by model",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sort_desc(label_replace(sum by (model) (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])), \"model\", \"(none)\", \"model\", \"\"))",
          "legendFormat": "{{model}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 11
    },
    {
      "type": "bargauge",
      "title": "Credits by workspace",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sort_desc(label_replace(sum by (workspace) (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])), \"workspace\", \"(none)\", \"workspace\", \"\"))",
          "legendFormat": "{{workspace}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 12
    },
    {
      "type": "table",
      "title": "Credits by surface",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "sort_desc(sum by (kind, surface) (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "credits"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "credits",
            "desc": true
          }
        ]
      },
      "id": 13
    },
    {
      "type": "table",
      "title": "Average credits per turn, by agent and model",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "label_replace(label_replace(sum by (agent, model) (max_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_credits_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])) / sum by (agent, model) (max_over_time(kiro_turns_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range]) - min_over_time(kiro_turns_total{service.name=~\"$service\", agent=~\"$agent\", workspace=~\"$workspace\", model=~\"$model\"}[$__range])), \"agent\", \"(none)\", \"agent\", \"\"), \"model\", \"(none)\", \"model\", \"\")",
