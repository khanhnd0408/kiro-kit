{
  "name": "spec-agent",
  "display_name": "Spec Agent",
  "description": "Writes the spec, plan, todo and checklist that implementing agents follow.",
  "triggers": "Use before implementing a feature: turn a request into a spec, an implementation plan, a todo list and a completion checklist.",
  "model": "claude-sonnet-4.5",
  "paid_model": "claude-sonnet-5.5",
  "tools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "fs_write",
    "execute_bash"
  ],
  "allowed_tools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "@kirocrew-core/skill_search",
    "@kirocrew-core/ask_question"
  ],
  "crew_servers": {
    "core": {
      "tools": [
        "skill_search",
        "ask_question"
      ]
    }
  },
  "skills": [
    "~/.kiro/crew/skills/spec-driven-workflow/SKILL.md"
  ],
  "prompt_files": [
    "prompts/spec-agent.md",
    "prompts/_working-rules.md",
    "prompts/_language.md"
  ]
}
