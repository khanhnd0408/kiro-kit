{
  "name": "orchestrator-agent",
  "display_name": "Orchestrator",
  "description": "Coordinates the specialist crewmates, watches long-running subagents with a check loop (a script, not the wait tool), and verifies results.",
  "triggers": "Use for any task that needs more than one specialist, a long-running job that must be supervised, or when it is unclear which crewmate should start.",
  "model": "claude-sonnet-4.5",
  "paid_model": "claude-sonnet-5.5",
  "tools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "execute_bash"
  ],
  "allowed_tools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "@kirocrew-core/spawn_run",
    "@kirocrew-core/spawn_status",
    "@kirocrew-core/spawn_list",
    "@kirocrew-core/spawn_steer",
    "@kirocrew-core/spawn_continue",
    "@kirocrew-core/spawn_release",
    "@kirocrew-core/ask_question"
  ],
  "crew_servers": {
    "core": {
      "tools": [
        "spawn_run",
        "spawn_status",
        "spawn_list",
        "spawn_steer",
        "spawn_continue",
        "spawn_release",
        "ask_question"
      ]
    }
  },
  "prompt_files": [
    "prompts/orchestrator-agent.md",
    "prompts/_language.md"
  ],
  "skills": [
    "~/.kiro/crew/skills/subagent-watch/SKILL.md"
  ],
  "extra_agent_fields": {
    "toolsSettings": {
      "execute_bash": {
        "allowedCommands": [
          "^python3 ~/\\.kiro/crew/skills/subagent-watch/scripts/watch_subagents\\.py [-A-Za-z0-9 ]*$"
        ]
      }
    }
  }
}
